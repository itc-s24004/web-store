// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../libs/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



generator markdown {
  provider = "prisma-markdown"
  output   = "./ERD.md"
  title    = "Web Store ERD"
}










model Image {
  id            String  @id @default(ulid())

  url           String

  storeId       String?
  store         Store?  @relation("images", fields: [storeId], references: [id], onDelete: Cascade)

  stores        Store[]
  productGroups ProductGroup[]
  products      Product[]
  customPageComponents CustomPageComponent[]
}


model Language {
  id                  String                @id @default(ulid())

  name                String                @unique

  systemTextLangMaps  SystemTextLangMap[]
  users               User[]
  
  storeLM               StoreLangMap[]
  productGroupLM        ProductGroupLangMap[]
  productLM             ProductLangMap[]
  customPageComponentLM CustomPageComponentLangMap[]
  messageTemplateLM     MessageTemplateLangMap[]
}



model SystemText {
  id        String  @id @default(ulid())

  text      String
  langMaps  SystemTextLangMap[]
}

model SystemTextLangMap {
  id            String    @id @default(ulid())

  text          String

  systemTextId  String
  systemText    SystemText @relation(fields: [systemTextId], references: [id], onDelete: Cascade)

  langId        String
  lang          Language   @relation(fields: [langId], references: [id], onDelete: Cascade)
}






model Store {
  id              String       @id @default(ulid())

  name            String
  description     String

  imgId           String?
  img             Image?    @relation(fields: [imgId], references: [id], onDelete: SetNull)

  readyMessageId  String?
  readyMessage    Message?  @relation(fields: [readyMessageId], references: [id], onDelete: SetNull)

  langMaps        StoreLangMap[]

  images          Image[]   @relation("images")
  productGroups   ProductGroup[]
  products        Product[]
  cartItems       CartItem[]
  orders          Order[]
  staffs          Staff[]

  messageTemplates MessageTemplate[]
  customPages      CustomPage[]
}

model StoreLangMap {
  id          String    @id @default(ulid())

  name        String
  description String

  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  langId      String
  lang        Language  @relation(fields: [langId], references: [id], onDelete: Cascade)


  @@unique([storeId, langId])
}







model ProductGroup {
  id          String    @id @default(ulid())

  name        String

  showTop     Boolean   @default(false)

  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  imgId       String?
  img         Image?    @relation(fields: [imgId], references: [id], onDelete: SetNull)

  items       ProductGroupItem[]
  langMaps    ProductGroupLangMap[]

  pageComponents CustomPageComponent[]

  @@unique([id, storeId])
}

model ProductGroupLangMap {
  id              String    @id @default(ulid())

  name            String

  productGroupId  String
  productGroup    ProductGroup @relation(fields: [productGroupId], references: [id], onDelete: Cascade)

  langId          String
  lang            Language  @relation(fields: [langId], references: [id], onDelete: Cascade)


  @@unique([productGroupId, langId])
}

model ProductGroupItem {
  id              String    @id @default(ulid())

  productGroupId  String
  productGroup    ProductGroup @relation(fields: [productGroupId], references: [id], onDelete: Cascade)

  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}




model Product {
  id              String            @id @default(ulid())

  storeId         String
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name            String
  description     String
  price           Int

  imgId           String?
  img             Image?            @relation(fields: [imgId], references: [id], onDelete: SetNull)


  isStockAccurate Boolean           @default(true)
  stock           Int               @default(0)

  @@unique([id, storeId])


  items           ProductGroupItem[]
  langMaps        ProductLangMap[]
  cartItems       CartItem[]
  messages        Message[]
  customPageComponents CustomPageComponent[]

}

model ProductLangMap {
  id          String    @id @default(ulid())

  name        String
  description String

  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  langId      String
  lang        Language  @relation(fields: [langId], references: [id], onDelete: Cascade)


  @@unique([productId, langId])
}















model CartItem {
  id        String  @id @default(ulid())

  count     Int

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)

  orderId   String?
  order     Order?  @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)


  @@unique([userId, productId, orderId])
}

model Order {
  id          String    @id @default(ulid())

  isReady     Boolean   @default(false)
  isReceived  Boolean   @default(false)
  isCanceled  Boolean   @default(false)

  index       Int       @default(autoincrement())
  requestedAt DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([id, storeId])
  

  cartItems CartItem[]
  messages  Message[]
}








model User {
  id        String    @id @default(ulid())
  email     String    @unique

  isAdmin   Boolean   @default(false)

  lockTime  DateTime  @default(now())

  subscribe_endpoint  String?
  subscribe_authKey   String?
  subscribe_p256dh    String?
  subscribe_hash      String?
  

  langId    String?
  lang      Language? @relation(fields: [langId], references: [id], onDelete: SetNull)


  cartItems CartItem[]
  orders    Order[]
  messages  Message[]

  verifyKey UserVerifyKey?

  staffs    Staff[]
}


model Staff {
  id        String    @id @default(ulid())
  
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  isOwner   Boolean   @default(false)


  @@unique([storeId, userId])
}







model MessageTemplate {
  id        String  @id @default(ulid())

  storeId   String?
  store     Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  title     String
  body      String

  langMaps  MessageTemplateLangMap[]

  messages  Message[]
}



model MessageTemplateLangMap {
  id                  String  @id @default(ulid())

  title               String
  body                String

  messageTemplateId   String
  messageTemplate     MessageTemplate @relation(fields: [messageTemplateId], references: [id], onDelete: Cascade)

  langId              String
  lang                Language        @relation(fields: [langId], references: [id], onDelete: Cascade)

  @@unique([messageTemplateId, langId])
}








model Message {
  id                String  @id @default(ulid())

  messageTemplateId String
  messageTemplate   MessageTemplate @relation(fields: [messageTemplateId], references: [id], onDelete: Cascade)

  url               String?
  label             String?
  
  createdAt DateTime @default(now())

  productId         String?
  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)


  stores            Store[]
  userMessageFlag   UserMessageFlag?
}


model UserMessageFlag {
  id        String  @id @default(ulid())

  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  isRead    Boolean @default(false)
}







model CustomPage {
  id          String  @id @default(ulid())

  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  title       String
  isPublished Boolean @default(false)

  components CustomPageComponent[]
}

model CustomPageComponent {
  id        String  @id @default(ulid())

  index     Int

  
  title     String?
  body      String?

  customPageId    String?
  customPage      CustomPage? @relation(fields: [customPageId], references: [id], onDelete: SetNull)
  
  imgId     String?
  img       Image?  @relation(fields: [imgId], references: [id], onDelete: SetNull)

  productGroupId  String?
  productGroup    ProductGroup? @relation(fields: [productGroupId], references: [id], onDelete: SetNull)

  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)


  langMaps CustomPageComponentLangMap[]
}

model CustomPageComponentLangMap {
  id          String    @id @default(ulid())

  title       String?
  body        String?

  componentId String
  component   CustomPageComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  langId      String
  lang        Language  @relation(fields: [langId], references: [id], onDelete: Cascade)

  @@unique([componentId, langId])
}











model UserVerifyKey {
  id        String    @id @default(ulid())

  userEmail String  @unique
  user      User    @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  key       String    @unique @default(uuid())
  expiresAt DateTime
}


model SystemVerifyKey {
  id        String  @id @default(ulid())

  expiresAt DateTime
  createdAt DateTime @default(now())
}


model ServiceKey {
  id        String  @id @default(ulid())

  name      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}